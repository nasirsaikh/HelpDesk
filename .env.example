DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional PostgreSQL. SQLite is used when POSTGRES_DB is absent.
# POSTGRES_DB=helpdesk
# POSTGRES_USER=helpdesk
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=helpdesk@example.com
# Company secrets require the immutable company UUID prefix shown beside secret fields.
# TENANT_<32-CHAR-UPPERCASE-UUID-HEX>_AI_TOKEN=
# TENANT_<32-CHAR-UPPERCASE-UUID-HEX>_GRAPH_SECRET=
